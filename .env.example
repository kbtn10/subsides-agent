# Copier vers .env et remplir.  ->  cp .env.example .env

# Clé API Anthropic (obligatoire). https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Modèle d'extraction. claude-haiku-4-5 = rapide/économique et supporte
# les structured outputs (JSON strict), ce qui est tout ce dont on a besoin ici.
# Pour des fiches ambiguës : claude-sonnet-5 ou claude-opus-4-8 (plus cher).
EXTRACTION_MODEL=claude-haiku-4-5

# Adresse de contact publiée dans le User-Agent du bot. Mets une vraie adresse :
# c'est ce qui permet à un webmaster de te joindre plutôt que de te bloquer.
CONTACT_EMAIL=ton.email@example.com

# Garde-fou de coût : nombre max de fiches extraites par run (toutes sources).
# Plafond de fiches traitées par run. 200 depuis le lot 5 : en dessous, les
# sources profondes (culture.be et ses ~1605 fiches d'archives) restaient
# tronquées silencieusement.
# COÛT : le PREMIER run complet paie une extraction LLM par fiche — compte
# ~1-2 € et 45-90 min pour 200 fiches. Les runs SUIVANTS sont quasi gratuits :
# le hash du texte source court-circuite l'extraction des pages inchangées.
# Le backfill culture.be complet est un cas à part, voir README § Backfill.
MAX_FICHES_PAR_RUN=200

# Lot 7 (étage 3) : plafond quotidien d'appels LLM par utilisateur pour
# l'accompagnement de candidature (checklist, conformité, copilote). Garde-fou
# de coût ; au-delà, l'utilisateur reçoit un message poli et réessaie le lendemain.
MAX_APPELS_ETAGE3_PAR_JOUR=50

# Garde-fou de coût du matching : nombre max de jugements LLM par analyse de profil.
MAX_JUGEMENTS_PAR_MATCHING=40

# Lot 9 — recherche web (script scripts/brulocalis_index.py). Brulocalis sert
# d'INDEX de titres ; pour chaque titre on cherche la fiche OFFICIELLE via une
# API de recherche, puis on extrait CELLE-CI. Sans clé, la recherche est inerte
# (aucune URL inventée). Par défaut : Brave Search (SEARCH_API_PROVIDER=brave).
# SEARCH_API_KEY=...
# SEARCH_API_PROVIDER=brave

# Veille nocturne (lot 3). true = scrape complet automatique chaque nuit.
CRON_SCRAPE=false
# Expression cron (défaut 03h00 Europe/Brussels). Pour tester : "*/5 * * * *".
# CRON_SCRAPE_CRON=0 3 * * *

# Frontend Next.js (lot 4a). Origines autorisées par CORS (séparées par virgule).
# Ajoute :3001 : Next bascule sur ce port si 3000 est occupé, et sans ça TOUTES
# les requêtes du front échouent (CORS) sans message clair à l'écran.
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001

# Auth Clerk (lot 4a). Laisser VIDE = mode vanilla (les vues /app et / marchent
# sans token). Renseigner CLERK_JWKS_URL active la vérification JWT sur
# /profils, /matching*, /matchings* (401 sans Bearer valide).
# CLERK_JWKS_URL se trouve dans le dashboard Clerk (API keys -> "JWKS URL"),
# forme : https://<ton-sous-domaine>.clerk.accounts.dev/.well-known/jwks.json
# CLERK_JWKS_URL=
# Optionnel : restreint l'azp (authorized party) du token. Plusieurs origines
# séparées par des virgules (dev :3000/:3001, prod apex + www).
# CLERK_AUTHORIZED_PARTY=http://localhost:3000,http://localhost:3001

# Optionnel (lot 4b) : repli admin tant que le template de token Clerk n'expose
# pas le rôle. Liste d'ids Clerk séparés par des virgules, autorisés sur
# /admin/*, /scrape et /status.
# ADMIN_CLERK_USER_IDS=user_xxx,user_yyy

# Optionnel : chemins. Laisser vide pour les valeurs par défaut.
# DB_PATH=data/subsides.db
# LOG_PATH=data/agent.log

# Lot 10A : coffre documentaire. Surface RGPD sensible -> derrière un flag.
# COFFRE_ACTIF=false tant qu'on n'est pas sur un hébergement sérieux.
COFFRE_ACTIF=false
# Clé de chiffrement AU REPOS des fichiers (Fernet). Générer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Ne JAMAIS committer la vraie clé. Sans clé, l'upload est refusé.
# DOCUMENTS_KEY=...
# DATA_DOCUMENTS=data/documents
